<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/titulo"
        android:textColor="@color/morado"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:text="@string/subtitulo"
        android:textColor="@color/texto"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/pantalla"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="@drawable/pantalla_fondo"
        android:gravity="center_vertical|end"
        android:padding="18dp"
        android:text="0"
        android:textColor="@color/texto"
        android:textSize="38sp"
        android:textStyle="bold" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:columnCount="4"
        android:rowCount="5">

        <Button style="@style/BotonEspecial" android:layout_columnSpan="3" android:onClick="limpiar" android:text="@string/limpiar" />
        <Button style="@style/BotonOperacion" android:onClick="elegirOperacion" android:tag="/" android:text="÷" />

        <Button style="@style/BotonNumero" android:onClick="escribirNumero" android:text="7" />
        <Button style="@style/BotonNumero" android:onClick="escribirNumero" android:text="8" />
        <Button style="@style/BotonNumero" android:onClick="escribirNumero" android:text="9" />
        <Button style="@style/BotonOperacion" android:onClick="elegirOperacion" android:tag="*" android:text="×" />

        <Button style="@style/BotonNumero" android:onClick="escribirNumero" android:text="4" />
        <Button style="@style/BotonNumero" android:onClick="escribirNumero" android:text="5" />
        <Button style="@style/BotonNumero" android:onClick="escribirNumero" android:text="6" />
        <Button style="@style/BotonOperacion" android:onClick="elegirOperacion" android:tag="-" android:text="−" />

        <Button style="@style/BotonNumero" android:onClick="escribirNumero" android:text="1" />
        <Button style="@style/BotonNumero" android:onClick="escribirNumero" android:text="2" />
        <Button style="@style/BotonNumero" android:onClick="escribirNumero" android:text="3" />
        <Button style="@style/BotonOperacion" android:onClick="elegirOperacion" android:tag="+" android:text="+" />

        <Button style="@style/BotonNumero" android:layout_columnSpan="2" android:onClick="escribirNumero" android:text="0" />
        <Button style="@style/BotonNumero" android:onClick="escribirNumero" android:text="." />
        <Button style="@style/BotonIgual" android:onClick="mostrarResultado" android:text="=" />
    </GridLayout>
</LinearLayout>
