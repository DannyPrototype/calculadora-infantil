<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CalculadoraInfantil" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/morado</item>
        <item name="android:navigationBarColor">@color/morado</item>
        <item name="android:statusBarColor">@color/morado</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="BotonBase" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:background">@drawable/boton_numero</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="BotonNumero" parent="BotonBase" />
    <style name="BotonOperacion" parent="BotonBase">
        <item name="android:background">@drawable/boton_operacion</item>
    </style>
    <style name="BotonEspecial" parent="BotonBase">
        <item name="android:background">@drawable/boton_especial</item>
        <item name="android:textSize">18sp</item>
    </style>
    <style name="BotonIgual" parent="BotonBase">
        <item name="android:background">@drawable/boton_igual</item>
    </style>
</resources>
